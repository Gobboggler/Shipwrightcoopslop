+            CollisionPoly* hitPoly;
+            s32 hitBgId;
+            Vec3f hitPos;
+            if (BgCheck_CameraLineTest1(&play->colCtx,
+                                        &caller->actor.focus.pos,
+                                        &actor->focus.pos,
+                                        &hitPos, &hitPoly,
+                                        1, 1, 1, 1, &hitBgId) &&
+                !SurfaceType_IsIgnoredByProjectiles(&play->colCtx, hitPoly, hitBgId)) {
+                actor = actor->next;
+                continue;
+            }
