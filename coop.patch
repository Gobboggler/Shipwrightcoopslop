+            actor = actor->next;
+        }
+
+        if (catIdx == 2 && (bestNormal != NULL || bestPriority != NULL)) {
+            break;
+        }
+        if (catIdx == 2 && !lookedHard) {
+            lookedHard = true;
+            catCount = ARRAY_COUNT(sCoopPriCats);
+        }
+    }
+
+    if (bestPriority != NULL) {
+        return bestPriority;
+    }
+    return bestNormal;
+}
