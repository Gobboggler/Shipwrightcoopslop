-        spBC.x = (160 * (spBC.x * spB4)) * var1;
-        spBC.x = CLAMP(spBC.x, -320.0f, 320.0f);
+        // SoH multiplayer: viewport-aware NDC-to-HUD-ortho conversion.
+        //
+        // Vanilla math was `spBC.x = (160 * (spBC.x * spB4)) * var1;`
+        // which assumes the scene was rendered to a full-screen viewport
+        // (320 wide internal). The 160 is half-screen-width — multiplying
+        // NDC [-1,+1] by 160 gives an offset in HUD-ortho pixels with
+        // 0 at full-screen center.
+        //
+        // In split-screen co-op, z_play.c's main pass shrinks P1's
+        // viewport to the LEFT HALF (leftX=0, rightX=160) at line
+        // ~1486 and rebuilds play->viewProjectionMtxF with that
+        // narrower projection (line ~1514-1518). After that rebuild,
+        // SkinMatrix_Vec3fMtxFMultXYZW above produces clip-space coords
+        // relative to the LEFT-HALF view — NDC=+1 means "right edge of
+        // P1's left-half view" which is the middle of the full screen.
+        //
+        // The vanilla `160 *` multiplier then incorrectly stretches
+        // that to "+160 HUD-ortho units" which is the right edge of
+        // the FULL screen — twice as far right as it should be. The
+        // entire reticle ends up shifted into P2's half, and the
+        // previous coopSkipReticleDraw band-aid (which suppressed the
+        // draw when spBC.x > -80) masked it by hiding the reticle in
+        // most cases — at the cost of "reticle disappears based on
+        // camera direction" (any target left of P1's view center got
+        // suppressed because the wrongly-doubled coord crossed the
+        // -80 threshold).
+        //
+        // Real fix: read the actual viewport from play->view and
+        // compute (a) the half-width of the viewport in HUD-ortho
+        // pixels, and (b) the offset of the viewport center from the
+        // full-screen center. Apply both to the NDC-to-pixel formula.
+        //
+        // - Full screen [0,320]: halfW=160, xOffset=0 → matches vanilla.
+        // - Left half  [0,160]: halfW=80,  xOffset=-80 → NDC=0 lands
+        //   at HUD x=-80 (left-half center), NDC=+1 lands at HUD x=0
+        //   (right edge of left half = middle of full screen).
+        //
+        // var1 (the lock-on intensity zoom factor) is applied to the
+        // NDC*halfW part but NOT the offset — the offset represents
+        // viewport center, which should always anchor at viewport
+        // center regardless of intensity.
+        //
+        // Y axis gets the same treatment for robustness, though in the
+        // current split-screen layout the Y viewport stays full-height
+        // (only X is shrunk).
+        //
+        // The CLAMP ranges are tightened to viewport bounds to keep
+        // the spinning-triangle history from bleeding past the edge —
+        // the entry->unk_0C radial spread can still stretch a few
+        // dozen pixels past the clamp during the converge animation,
+        // but that's much less visible than the previous "entire
+        // reticle in wrong half" behavior. If tighter constraint is
+        // needed later we can wrap the draw loop in a scissor.
+        f32 coopVpHalfW = 160.0f;
+        f32 coopVpXOffset = 0.0f;
+        f32 coopVpHalfH = 120.0f;
+        f32 coopVpYOffset = 0.0f;
+        f32 coopClampXMin = -320.0f;
+        f32 coopClampXMax = 320.0f;
+        f32 coopClampYMin = -240.0f;
+        f32 coopClampYMax = 240.0f;
+        {
+            f32 vpW = (f32)(play->view.viewport.rightX - play->view.viewport.leftX);
+            f32 vpH = (f32)(play->view.viewport.bottomY - play->view.viewport.topY);
+            // Only override defaults when the viewport is meaningfully
+            // smaller than full screen — guards against divide-by-zero,
+            // negative widths, and any pathological transient state
+            // between viewport swaps.
+            if (vpW > 8.0f && vpW < (f32)SCREEN_WIDTH - 1.0f) {
+                coopVpHalfW = vpW * 0.5f;
+                coopVpXOffset = (f32)(play->view.viewport.leftX + play->view.viewport.rightX) * 0.5f -
+                                (f32)SCREEN_WIDTH * 0.5f;
+                coopClampXMin = coopVpXOffset - coopVpHalfW;
+                coopClampXMax = coopVpXOffset + coopVpHalfW;
+            }
+            if (vpH > 8.0f && vpH < (f32)SCREEN_HEIGHT - 1.0f) {
+                coopVpHalfH = vpH * 0.5f;
+                // HUD ortho Y is inverted vs pixel Y (positive = up,
+                // pixel Y=0 is top). Viewport center in pixel terms
+                // is (topY + bottomY)/2; in HUD ortho terms it's
+                // SCREEN_HEIGHT/2 - that.
+                coopVpYOffset = (f32)SCREEN_HEIGHT * 0.5f -
+                                (f32)(play->view.viewport.topY + play->view.viewport.bottomY) * 0.5f;
+                coopClampYMin = coopVpYOffset - coopVpHalfH;
+                coopClampYMax = coopVpYOffset + coopVpHalfH;
+            }
+        }
+
+        spBC.x = (coopVpHalfW * (spBC.x * spB4)) * var1 + coopVpXOffset;
+        // SoH multiplayer: user-tunable nudge in HUD-ortho pixels.
+        // Even with the viewport-aware math above, libultraship's
+        // widescreen aspect-ratio adjustment can leave the reticle
+        // a few pixels off the rendered target — `AdjXForAspectRatio`
+        // applies to clip-space x on every 3D vertex but doesn't
+        // touch HUD ortho coords, so the same world point projects
+        // through the 3D pipeline to one screen pixel and through
+        // this HUD path to a slightly different one. Exposing the
+        // offset as a CVar lets the user dial it in by eye. Sliders
