+                Actor* coopP1 = camera->play->actorCtx.actorLists[ACTORCAT_PLAYER].head;
+                if (coopP1 != NULL && coopP1->next != NULL) {
+                    Actor* coopP2 = coopP1->next;
+                    if (coopP2->world.pos.x == coopP2->world.pos.x &&
+                        coopP2->world.pos.y == coopP2->world.pos.y &&
